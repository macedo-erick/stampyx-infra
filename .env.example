# Reference only. The deploy workflow renders the real .env onto the VPS; nothing here is
# read from the repo.

REGISTRY=southamerica-east1-docker.pkg.dev/<gcp-project>/stampyx
API_TAG=<sha>
UI_TAG=<sha>
LANDING_TAG=<sha>
MAIL_TAG=<sha>

APP_DB_PASSWORD='<stampyx_app password>'
KEYCLOAK_ADMIN_CLIENT_SECRET='<stampyx-api-admin secret>'
STAMPYX_PROVISIONING_SECRET='<shared with the auth stack>'
# At least 32 chars. Signs the panel tokens of mailbox users.
STAMPYX_JWT_SECRET='<openssl rand -base64 48>'
# A repository *variable*, not a secret. Phase 8 sets it to false, together with the admin
# approval surface it needs.
STAMPYX_ACCOUNT_AUTO_APPROVE=true
MAIL_INTERNAL_SECRET='<shared with postfix and dovecot>'
MAIL_MASTER_PASSWORD='<dovecot master user password>'
MAIL_PUBLIC_IP=<the IP the PTR resolves to>

API_LOG_LEVEL=info
